{
  "name": "WTW Enterprise Report Theme",
  "version": "1.0.0",
  "description": "Production-ready Power BI theme based on WTW brand standards and enterprise design guidelines",
  
  "dataColors": [
    "#6D398C",
    "#7F35B2",
    "#00A3E0",
    "#43B02A",
    "#F2A900",
    "#E31B23",
    "#5C6670",
    "#00B5E2",
    "#8031A7",
    "#6CC24A"
  ],

  "good": "#43B02A",
  "neutral": "#F2A900",
  "bad": "#E31B23",
  "minimum": "#E31B23",
  "center": "#F2A900",
  "maximum": "#43B02A",

  "foreground": "#333333",
  "foregroundNeutralSecondary": "#5C6670",
  "foregroundNeutralTertiary": "#7A7A7A",
  "background": "#FFFFFF",
  "backgroundLight": "#F9F9F9",
  "backgroundNeutral": "#F2F2F2",
