  "visualStyles": {
    "*": {
      "*": {
        "general": [{
          "responsive": true,
          "keepLayerOrder": true
        }],
        "background": [{
          "show": true,
          "color": {"solid": {"color": "#FFFFFF"}},
          "transparency": 0
        }],
        "lockAspect": [{
          "show": false
        }],
        "border": [{
          "show": false,
          "color": {"solid": {"color": "#E6E6E6"}},
          "radius": 0
        }],
        "visualHeader": [{
          "show": false
        }],
        "visualHeaderTooltip": [{
          "show": true
        }],
        "dropShadow": [{
          "show": false
        }],
        "padding": [{
          "top": 8,
          "bottom": 8,
          "left": 8,
          "right": 8
        }],
        "title": [{
          "show": true,
          "fontColor": {"solid": {"color": "#6D398C"}},
          "fontFamily": "Arial",
          "fontSize": 12,
          "bold": true,
          "italic": false,
          "underline": false,
          "alignment": "left"
        }],
        "subTitle": [{
          "show": false,
          "fontColor": {"solid": {"color": "#5C6670"}},
          "fontFamily": "Arial",
          "fontSize": 10,
          "bold": false,
          "italic": false,
          "underline": false,
          "alignment": "left"
        }],
        "divider": [{
          "show": false,
          "color": {"solid": {"color": "#E6E6E6"}},
          "style": "solid",
          "width": 1
