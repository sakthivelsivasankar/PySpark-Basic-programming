      "fontSize": 9,
      "fontWeight": "normal",
      "color": "#7F35B2"
    },
    "reportRunDate": {
      "fontFace": "Arial",
      "fontSize": 9,
      "fontWeight": "normal",
      "color": "#000000"
    },
    "exportButton": {
      "fontFace": "Arial",
      "fontSize": 10,
      "fontWeight": "normal",
      "color": "#000000"
    },
    "filtersApplied": {
      "fontFace": "Arial",
      "fontSize": 9,
      "fontWeight": "normal",
      "color": "#000000"
    }
