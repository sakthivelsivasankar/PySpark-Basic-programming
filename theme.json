        "spacing": [{
          "customizeSpacing": true,
          "verticalSpacing": 8,
          "horizontalSpacing": 8
        }]
      }
    },

    "page": {
      "*": {
        "background": [{
          "color": {"solid": {"color": "#FFFFFF"}},
          "transparency": 0
        }],
        "wallpaper": [{
          "color": {"solid": {"color": "#F9F9F9"}}
        }],
        "outspace": [{
          "color": {"solid": {"color": "#F2F2F2"}}
        }],
        "outspacePane": [{
          "backgroundColor": {"solid": {"color": "#F2F2F2"}}
        }]
      }
    },

    "textbox": {
      "*": {
        "background": [{
          "show": false
