      "fontSize": 9,
      "fontWeight": "normal",
      "color": "#333333"
    },
    "largeLabel": {
      "fontFace": "Arial",
      "fontSize": 10,
      "fontWeight": "normal",
      "color": "#333333"
    },
    "smallLabel": {
      "fontFace": "Arial",
      "fontSize": 8,
      "fontWeight": "normal",
      "color": "#5C6670"
    },
    "callout": {
      "fontFace": "Arial",
      "fontSize": 24,
      "fontWeight": "bold",
      "color": "#6D398C"
    },
    "kpiValue": {
      "fontFace": "Arial",
      "fontSize": 28,
      "fontWeight": "bold",
      "color": "#333333"
    },
    "footnote": {
